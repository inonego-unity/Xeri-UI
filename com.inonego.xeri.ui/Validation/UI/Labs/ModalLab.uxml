<!-- BLOCK_HEADER_BEGIN =====================================================================
파일명 : ModalLab.uxml
수정일 : 2026-10-04

# 설명
Root UIContext Modal stack과 nested focus 복원을 직접 조작하는 Modal Lab control surface.
======================================================================= BLOCK_HEADER_END -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Shared/XeriValidationTokens.uss" />
    <Style src="../Shared/XeriValidationComponents.uss" />
    <Style src="XeriValidationLabs.uss" />

    <ui:VisualElement name="ModalLabRoot" class="xeri-validation-lab">
        <ui:VisualElement class="xeri-validation-lab__header">
            <ui:VisualElement class="xeri-validation-lab__heading">
                <ui:Label text="Modal Lab" class="xeri-validation-lab__title" />
                <ui:Label text="Root modal stack · focus containment" class="xeri-validation-lab__copy" />
            </ui:VisualElement>
            <ui:Label name="ModalLabStatus" text="Root Modal Depth · 0" class="xeri-validation-lab__status" />
        </ui:VisualElement>

        <ui:ScrollView mode="Vertical" class="xeri-validation-lab__scroll">
            <ui:VisualElement class="xeri-validation-lab__group">
                <ui:Label text="Modal stack" class="xeri-validation-lab__group-title" />
                <ui:VisualElement class="xeri-validation-lab__actions">
                    <ui:Button name="ModalOpen" text="Open modal A" class="xeri-validation-button xeri-validation-button--primary" />
                    <ui:Button name="ModalNested" text="Open nested B" class="xeri-validation-button xeri-validation-button--secondary" />
                    <ui:Button name="ModalCloseTop" text="Close top" class="xeri-validation-button xeri-validation-button--quiet" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="xeri-validation-lab__group">
                <ui:Label text="Expected behavior" class="xeri-validation-lab__group-title" />
                <ui:Label
                    text="Modal B owns focus while on top. Closing B restores Modal A focus; closing A returns authority to the underlying UI."
                    class="xeri-validation-copy" />
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
