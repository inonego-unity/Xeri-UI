<!-- BLOCK_HEADER_BEGIN =====================================================================
파일명 : CoreLab.uxml
수정일 : 2026-10-19

# 설명
Transient Presentation, Spotlight와 Scene Fade를 반복 실행하는 Core Lab control surface.
======================================================================= BLOCK_HEADER_END -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Shared/XeriValidationTokens.uss" />
    <Style src="../Shared/XeriValidationComponents.uss" />
    <Style src="XeriValidationLabs.uss" />

    <ui:VisualElement name="CoreLabRoot" class="xeri-validation-lab">
        <ui:VisualElement class="xeri-validation-lab__header">
            <ui:VisualElement class="xeri-validation-lab__heading">
                <ui:Label text="기본 기능 실험실" class="xeri-validation-lab__title" />
                <ui:Label text="화면 표시 · 강조 효과 · 화면 전환" class="xeri-validation-lab__copy" />
            </ui:VisualElement>
            <ui:Label name="CoreLabStatus" text="준비됨" class="xeri-validation-lab__status" />
        </ui:VisualElement>

        <ui:ScrollView mode="Vertical" class="xeri-validation-lab__scroll">
            <ui:VisualElement class="xeri-validation-lab__group">
                <ui:Label text="기본 화면 목록" class="xeri-validation-lab__group-title" />
                <ui:VisualElement class="xeri-validation-lab__actions">
                    <ui:Button name="CoreScreenHome" text="홈 열기" class="xeri-validation-button xeri-validation-button--secondary" />
                    <ui:Button name="CoreScreenPush" text="상세 추가" class="xeri-validation-button xeri-validation-button--primary" />
                    <ui:Button name="CoreScreenReplace" text="현재 화면 교체" class="xeri-validation-button xeri-validation-button--secondary" />
                    <ui:Button name="CoreScreenPop" text="이전 화면" class="xeri-validation-button xeri-validation-button--quiet" />
                    <ui:Button name="CoreScreenClear" text="모두 닫기" class="xeri-validation-button xeri-validation-button--quiet" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="xeri-validation-lab__group">
                <ui:Label text="화면 표시" class="xeri-validation-lab__group-title" />
                <ui:VisualElement class="xeri-validation-lab__actions">
                    <ui:Button name="CoreOverlay" text="알림 표시 전환" class="xeri-validation-button xeri-validation-button--secondary" />
                    <ui:Button name="CoreSpotlight" text="강조 표시" class="xeri-validation-button xeri-validation-button--quiet" />
                    <ui:Button name="CoreFade" text="화면 전환" class="xeri-validation-button xeri-validation-button--primary" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="CoreSpotlightTarget" class="xeri-validation-lab__target">
                <ui:Label text="강조할 영역" />
            </ui:VisualElement>
            <ui:VisualElement class="xeri-validation-lab__group">
                <ui:Label text="안내" class="xeri-validation-lab__group-title" />
                <ui:Label
                    text="실제 UI 실행 영역에서 화면과 효과를 조작합니다. 각 버튼으로 표시 상태와 입력 동작을 확인해 보세요."
                    class="xeri-validation-copy" />
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
