<!-- BLOCK_HEADER_BEGIN =====================================================================
파일명 : WindowLab.uxml
수정일 : 2026-10-19

# 설명
Window state/StackLayer와 Minimized-only Tray projection을 직접 조작하는 Window Lab control surface.
======================================================================= BLOCK_HEADER_END -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Shared/XeriValidationTokens.uss" />
    <Style src="../Shared/XeriValidationComponents.uss" />
    <Style src="XeriValidationLabs.uss" />

    <ui:VisualElement name="WindowLabRoot" class="xeri-validation-lab">
        <ui:VisualElement class="xeri-validation-lab__header">
            <ui:VisualElement class="xeri-validation-lab__heading">
                <ui:Label text="창 실험실" class="xeri-validation-lab__title" />
                <ui:Label text="창 상태 · 표시 순서 · 작업 목록" class="xeri-validation-lab__copy" />
            </ui:VisualElement>
            <ui:Label name="WindowLabStatus" text="준비됨" class="xeri-validation-lab__status" />
        </ui:VisualElement>

        <ui:ScrollView mode="Vertical" class="xeri-validation-lab__scroll">
            <ui:VisualElement class="xeri-validation-lab__group">
                <ui:Label text="창" class="xeri-validation-lab__group-title" />
                <ui:VisualElement class="xeri-validation-lab__actions">
                    <ui:Button name="WindowOpenTool" text="도구 창 열기" class="xeri-validation-button xeri-validation-button--secondary" />
                    <ui:Button name="WindowOpenAlwaysOnTop" text="항상 위 창 열기" class="xeri-validation-button xeri-validation-button--secondary" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="xeri-validation-lab__group">
                <ui:Label text="선택한 창 상태" class="xeri-validation-lab__group-title" />
                <ui:VisualElement class="xeri-validation-lab__actions">
                    <ui:Button name="WindowMinimizeActive" text="최소화" class="xeri-validation-button xeri-validation-button--quiet" />
                    <ui:Button name="WindowMaximizeActive" text="최대화" class="xeri-validation-button xeri-validation-button--primary" />
                    <ui:Button name="WindowNormalActive" text="원래 크기" class="xeri-validation-button xeri-validation-button--secondary" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="xeri-validation-lab__group">
                <ui:Label text="최소화된 창 목록" class="xeri-validation-lab__group-title" />
                <ui:Label
                    text="아래 작업 표시줄에는 열린 모든 창이, 이 목록에는 최소화된 창만 표시됩니다."
                    class="xeri-validation-copy" />
                <ui:VisualElement name="WindowProjectionHost" />
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
