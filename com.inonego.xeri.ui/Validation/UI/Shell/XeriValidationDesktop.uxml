<!-- BLOCK_HEADER_BEGIN =====================================================================
파일명 : XeriValidationDesktop.uxml
수정일 : 2026-10-19

# 설명
scene-authored Validation Desktop의 wallpaper/system bar/desktop launcher와 ManagedRoot, authored Status/Taskbar placement를 정의한다.
바탕화면은 16:9 작업 공간과 대각선으로 겹치는 부드러운 radial 배경을 사용한다.
======================================================================= BLOCK_HEADER_END -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Shared/XeriValidationTokens.uss" />
    <Style src="../Shared/XeriValidationComponents.uss" />
    <Style src="XeriValidationShell.uss" />

    <ui:VisualElement name="DesktopRoot" authoring-id="100" class="xeri-validation xeri-validation-desktop">
        <ui:VisualElement class="xeri-validation-desktop__wallpaper" picking-mode="Ignore" />
        <ui:VisualElement class="xeri-validation-desktop__ambient" picking-mode="Ignore">
            <ui:VisualElement class="xeri-validation-desktop__radial xeri-validation-desktop__radial--cyan" picking-mode="Ignore" />
            <ui:VisualElement class="xeri-validation-desktop__radial xeri-validation-desktop__radial--violet" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement class="xeri-validation-desktop__chrome">
            <ui:VisualElement class="xeri-validation-desktop__brand">
                <ui:VisualElement class="xeri-validation-desktop__mark"><ui:Label text="X" /></ui:VisualElement>
                <ui:Label text="Xeri 데스크톱" class="xeri-validation-desktop__title" />
                <ui:Label text="검증 작업 공간" class="xeri-validation-desktop__subtitle" />
            </ui:VisualElement>
            <ui:VisualElement class="xeri-validation-desktop__tools">
                <ui:Button name="ToggleChecklist" text="검증 현황" class="xeri-validation-button xeri-validation-button--quiet" />
                <ui:Button name="ToggleMonitor" text="시스템 모니터" class="xeri-validation-button xeri-validation-button--quiet" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="xeri-validation-launcher">
            <ui:VisualElement class="xeri-validation-launcher__group">
                <ui:Label text="앱" class="xeri-validation-launcher__heading" />
                <ui:VisualElement class="xeri-validation-launcher__row">
                    <ui:Button name="LaunchTaskBoard" class="xeri-validation-launcher__item">
                        <ui:Label text="할 일" class="xeri-validation-launcher__icon" />
                        <ui:Label text="할 일" class="xeri-validation-launcher__label" />
                    </ui:Button>
                    <ui:Button name="LaunchPreferences" class="xeri-validation-launcher__item">
                        <ui:Label text="설정" class="xeri-validation-launcher__icon" />
                        <ui:Label text="환경 설정" class="xeri-validation-launcher__label" />
                    </ui:Button>
                    <ui:Button name="LaunchApplicationA" class="xeri-validation-launcher__item">
                        <ui:Label text="A" class="xeri-validation-launcher__icon" />
                        <ui:Label text="앱 A" class="xeri-validation-launcher__label" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="xeri-validation-launcher__row">
                    <ui:Button name="LaunchApplicationB" class="xeri-validation-launcher__item">
                        <ui:Label text="B" class="xeri-validation-launcher__icon" />
                        <ui:Label text="앱 B" class="xeri-validation-launcher__label" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="xeri-validation-launcher__group">
                <ui:Label text="시스템 도구" class="xeri-validation-launcher__heading" />
                <ui:VisualElement class="xeri-validation-launcher__row">
                    <ui:Button name="LaunchCoreLab" class="xeri-validation-launcher__item">
                        <ui:Label text="기본" class="xeri-validation-launcher__icon" />
                        <ui:Label text="기본 기능 실험실" class="xeri-validation-launcher__label" />
                    </ui:Button>
                    <ui:Button name="LaunchWindowLab" class="xeri-validation-launcher__item">
                        <ui:Label text="창" class="xeri-validation-launcher__icon" />
                        <ui:Label text="창 실험실" class="xeri-validation-launcher__label" />
                    </ui:Button>
                    <ui:Button name="LaunchModalLab" class="xeri-validation-launcher__item">
                        <ui:Label text="대화" class="xeri-validation-launcher__icon" />
                        <ui:Label text="대화상자 실험실" class="xeri-validation-launcher__label" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement
            name="ManagedRoot"
            authoring-id="120"
            class="xeri-validation-desktop__managed-root"
            picking-mode="Ignore">
            <ui:VisualElement
                name="DesktopStatus"
                authoring-id="130"
                class="xeri-validation-monitor"
                picking-mode="Ignore">
                <ui:VisualElement class="xeri-validation-monitor__header">
                    <ui:VisualElement>
                        <ui:Label text="시스템 모니터" class="xeri-validation-title" />
                        <ui:Label text="실시간 실행 상태" class="xeri-validation-copy" />
                    </ui:VisualElement>
                    <ui:VisualElement class="xeri-validation-monitor__pulse" />
                </ui:VisualElement>
                <ui:VisualElement class="xeri-validation-monitor__row">
                    <ui:Label text="실행 상태" class="xeri-validation-monitor__label" />
                    <ui:Label name="MonitorRuntimeState" text="시작 중" class="xeri-validation-monitor__value" />
                </ui:VisualElement>
                <ui:VisualElement class="xeri-validation-monitor__row">
                    <ui:Label text="UI 출력 방식" class="xeri-validation-monitor__label" />
                    <ui:Label name="MonitorOutputPolicy" text="—" class="xeri-validation-monitor__value" />
                </ui:VisualElement>
                <ui:VisualElement class="xeri-validation-monitor__row">
                    <ui:Label text="창 수" class="xeri-validation-monitor__label" />
                    <ui:Label name="MonitorWindowCount" text="0" class="xeri-validation-monitor__value" />
                </ui:VisualElement>
                <ui:VisualElement class="xeri-validation-monitor__row">
                    <ui:Label text="선택한 창" class="xeri-validation-monitor__label" />
                    <ui:Label name="MonitorActiveWindow" text="바탕화면" class="xeri-validation-monitor__value" />
                </ui:VisualElement>
                <ui:VisualElement class="xeri-validation-monitor__row">
                    <ui:Label text="창 상태" class="xeri-validation-monitor__label" />
                    <ui:Label name="MonitorWindowState" text="—" class="xeri-validation-monitor__value" />
                </ui:VisualElement>
                <ui:VisualElement class="xeri-validation-monitor__row">
                    <ui:Label text="기본 화면 / 대화상자" class="xeri-validation-monitor__label" />
                    <ui:VisualElement class="xeri-validation-row">
                        <ui:Label name="MonitorScreenCount" text="0" class="xeri-validation-monitor__value" />
                        <ui:Label text="/" class="xeri-validation-monitor__value" />
                        <ui:Label name="MonitorModalCount" text="0" class="xeri-validation-monitor__value" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="xeri-validation-monitor__row">
                    <ui:Label text="최근 입력" class="xeri-validation-monitor__label" />
                    <ui:Label name="MonitorInputDevice" text="입력 없음" class="xeri-validation-monitor__value" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="DesktopTaskbar" authoring-id="140" class="xeri-validation-taskbar-dock" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
