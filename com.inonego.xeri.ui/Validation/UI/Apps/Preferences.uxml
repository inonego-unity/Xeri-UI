<!-- BLOCK_HEADER_BEGIN =====================================================================
파일명 : Preferences.uxml
수정일 : 2026-10-19

# 설명
TextField, DropdownField, Toggle, Slider와 Button의 focus/input을 자연스럽게 확인하는 Preferences application view.
======================================================================= BLOCK_HEADER_END -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Shared/XeriValidationTokens.uss" />
    <Style src="../Shared/XeriValidationComponents.uss" />
    <Style src="XeriValidationApps.uss" />

    <ui:VisualElement name="PreferencesRoot" class="xeri-validation-app xeri-validation-preferences">
        <ui:VisualElement class="xeri-validation-app__header">
            <ui:VisualElement class="xeri-validation-app__heading">
                <ui:Label text="환경 설정" class="xeri-validation-app__title" />
                <ui:Label text="내게 맞는 작업 공간을 설정하세요." class="xeri-validation-app__subtitle" />
            </ui:VisualElement>
            <ui:Label name="PreferencesStatus" text="준비됨" class="xeri-validation-app__status" />
        </ui:VisualElement>

        <ui:ScrollView mode="Vertical" class="xeri-validation-app__scroll">
            <ui:VisualElement class="xeri-validation-app__section xeri-validation-preferences__grid">
                <ui:Label text="화면과 입력" class="xeri-validation-app__section-title" />
                <ui:Label text="화면 설정은 열려 있는 모든 창에 적용되며 다음 실행에도 유지됩니다." class="xeri-validation-app__section-copy" />
                <ui:DropdownField name="PaletteField" label="화면 모드" />
                <ui:DropdownField name="ThemeField" label="창 스타일" />
                <ui:TextField name="DisplayNameField" label="표시 이름" />
                <ui:Toggle name="CompactModeField" label="촘촘한 간격" />
                <ui:Slider name="ScaleField" label="슬라이더 미리보기" />
            </ui:VisualElement>

            <ui:VisualElement class="xeri-validation-preferences__footer">
                <ui:Label
                    text="적용하면 간격 설정을 저장합니다. 이름과 슬라이더는 입력 확인용입니다."
                    class="xeri-validation-preferences__hint" />
                <ui:Button name="PreferencesApply" text="적용" class="xeri-validation-button xeri-validation-button--primary" />
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
