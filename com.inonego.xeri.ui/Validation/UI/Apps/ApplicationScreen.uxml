<!-- BLOCK_HEADER_BEGIN =====================================================================
파일명 : ApplicationScreen.uxml
수정일 : 2026-10-19

# 설명
Application A/B가 동일하게 사용하는 Child UIContext Screen view.
현재 Screen, navigation/modal action과 child-context 상태를 한 화면에서 읽을 수 있게 구성한다.
======================================================================= BLOCK_HEADER_END -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Shared/XeriValidationTokens.uss" />
    <Style src="../Shared/XeriValidationComponents.uss" />
    <Style src="XeriValidationApps.uss" />

    <ui:VisualElement name="ApplicationScreenRoot" class="xeri-validation-app xeri-validation-application">
        <ui:VisualElement class="xeri-validation-app__header">
            <ui:VisualElement class="xeri-validation-app__heading">
                <ui:Label name="ApplicationName" text="앱" class="xeri-validation-app__title" />
                <ui:Label text="앱마다 독립적으로 동작하는 UI" class="xeri-validation-app__subtitle" />
            </ui:VisualElement>
            <ui:Label name="ApplicationLifecycle" text="여는 중" class="xeri-validation-app__status" />
        </ui:VisualElement>

        <ui:ScrollView mode="Vertical" class="xeri-validation-app__scroll">
            <ui:VisualElement class="xeri-validation-application__hero">
                <ui:Label text="현재 화면" class="xeri-validation-application__eyebrow" />
                <ui:Label name="ApplicationScreenName" text="홈" class="xeri-validation-application__screen-title" />
                <ui:Label
                    text="상세 화면과 중첩 대화상자를 열어 보세요. 다른 앱으로 전환한 뒤 돌아와 입력 위치와 화면 상태가 유지되는지 확인할 수 있습니다."
                    class="xeri-validation-app__section-copy" />

                <ui:VisualElement class="xeri-validation-application__actions">
                    <ui:Button name="ApplicationNavigate" text="상세 보기" class="xeri-validation-button xeri-validation-button--primary" />
                    <ui:Button name="ApplicationModal" text="대화상자 열기" class="xeri-validation-button xeri-validation-button--secondary" />
                    <ui:Button name="ApplicationCloseScreen" text="화면 닫기" class="xeri-validation-button xeri-validation-button--quiet" />
                </ui:VisualElement>

                <ui:VisualElement class="xeri-validation-application__summary">
                    <ui:VisualElement class="xeri-validation-application__summary-card">
                        <ui:Label text="실행 영역" class="xeri-validation-application__summary-label" />
                        <ui:Label text="독립된 UI 영역" class="xeri-validation-application__summary-value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="xeri-validation-application__summary-card">
                        <ui:Label text="화면 구성" class="xeri-validation-application__summary-label" />
                        <ui:Label text="다른 앱과 분리" class="xeri-validation-application__summary-value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="xeri-validation-application__summary-card">
                        <ui:Label text="입력 위치" class="xeri-validation-application__summary-label" />
                        <ui:Label text="이전 입력 위치 복원" class="xeri-validation-application__summary-value" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
