<!-- BLOCK_HEADER_BEGIN =====================================================================
파일명 : TaskBoard.uxml
수정일 : 2026-10-19

# 설명
Window를 자연스럽게 조작하면서 기본 UITK input control도 함께 행사하는 Task Board application view.
======================================================================= BLOCK_HEADER_END -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Shared/XeriValidationTokens.uss" />
    <Style src="../Shared/XeriValidationComponents.uss" />
    <Style src="XeriValidationApps.uss" />

    <ui:VisualElement name="TaskBoardRoot" class="xeri-validation-app xeri-validation-task-board">
        <ui:VisualElement class="xeri-validation-app__header">
            <ui:VisualElement class="xeri-validation-app__heading">
                <ui:Label text="할 일" class="xeri-validation-app__title" />
                <ui:Label text="할 일을 입력하고, 창을 움직이거나 작업 표시줄에서 다시 열어 보세요." class="xeri-validation-app__subtitle" />
            </ui:VisualElement>
            <ui:Label name="TaskStatus" text="0 / 0 완료" class="xeri-validation-app__status" />
        </ui:VisualElement>

        <ui:ScrollView mode="Vertical" class="xeri-validation-app__scroll">
            <ui:VisualElement class="xeri-validation-app__section">
                <ui:Label text="빠르게 추가" class="xeri-validation-app__section-title" />
                <ui:Label text="창을 이동하거나 크기를 바꾸고 다시 선택해도 입력을 이어갈 수 있습니다." class="xeri-validation-app__section-copy" />
                <ui:VisualElement class="xeri-validation-app__input-row">
                    <ui:TextField name="TaskInput" />
                    <ui:Button name="TaskAdd" text="추가" class="xeri-validation-button xeri-validation-button--primary" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="xeri-validation-app__section">
                <ui:Label text="할 일 목록" class="xeri-validation-app__section-title" />
                <ui:VisualElement name="TaskList" class="xeri-validation-app__list" />
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
