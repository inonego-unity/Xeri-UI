.xeri-window {
    --xeri-window-button-text-color: rgb(235, 235, 235);
    --xeri-window-button-close-text-color: rgb(255, 255, 255);
    --xeri-window-button-close-color: rgb(176, 32, 24);
    --xeri-window-button-close-hover-color: rgb(210, 52, 38);
    --xeri-window-transparent-color: rgba(0, 0, 0, 0);

    position: absolute;
    flex-direction: column;
    min-width: 152px;
    min-height: 80px;
    overflow: hidden;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.xeri-window__title-bar {
    position: relative;
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 30px;
    min-height: 30px;
    flex-shrink: 0;
}

.xeri-window__title-icon {
    display: none;
    width: 10px;
    height: 10px;
    margin-left: 10px;
    margin-right: 8px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    flex-shrink: 0;
}

.xeri-window__title-label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 40px;
    height: 100%;
    font-size: 12px;
    -unity-text-align: middle-left;
}

.xeri-window__title-actions {
    position: relative;
    flex-direction: row;
    align-items: center;
    height: 100%;
    flex-shrink: 0;
}

.xeri-window__button {
    position: relative;
    width: 32px;
    height: 100%;
    min-width: 32px;
    margin-left: 0;
    margin-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    color: var(--xeri-window-button-text-color);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color, color;
    transition-duration: 0.08s;
    transition-timing-function: ease-out;
    flex-shrink: 0;
}

.xeri-window__button-icon {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: var(--xeri-window-button-text-color);
    transition-property: color;
    transition-duration: 0.08s;
    transition-timing-function: ease-out;
}

.xeri-window .xeri-window__button.xeri-window__button--close .xeri-window__button-icon {
    color: var(--xeri-window-button-close-text-color);
}

.xeri-window .xeri-window__button.xeri-window__button--close {
    color: var(--xeri-window-button-close-text-color);
    background-color: var(--xeri-window-button-close-color);
}

.xeri-window .xeri-window__button.xeri-window__button--close:hover {
    color: var(--xeri-window-button-close-text-color);
    background-color: var(--xeri-window-button-close-hover-color);
}

.xeri-window__content {
    position: relative;
    flex-grow: 1;
    padding-top: 10px;
    padding-left: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
}

.xeri-window__resize {
    position: absolute;
    background-color: var(--xeri-window-transparent-color);
}

.xeri-window__resize--left,
.xeri-window__resize--right {
    top: 8px;
    bottom: 8px;
    width: 6px;
}

.xeri-window__resize--left {
    left: -3px;
}

.xeri-window__resize--right {
    right: -3px;
}

.xeri-window__resize--top,
.xeri-window__resize--bottom {
    left: 8px;
    right: 8px;
    height: 6px;
}

.xeri-window__resize--top {
    top: -3px;
}

.xeri-window__resize--bottom {
    bottom: -3px;
}

.xeri-window__resize--top-left,
.xeri-window__resize--top-right,
.xeri-window__resize--bottom-left,
.xeri-window__resize--bottom-right {
    width: 10px;
    height: 10px;
}

.xeri-window__resize--top-left {
    left: -3px;
    top: -3px;
}

.xeri-window__resize--top-right {
    right: -3px;
    top: -3px;
}

.xeri-window__resize--bottom-left {
    left: -3px;
    bottom: -3px;
}

.xeri-window__resize--bottom-right {
    right: -3px;
    bottom: -3px;
}

.xeri-window--minimized {
    display: none;
}

.xeri-window--closed {
    display: none;
}

.xeri-window--maximized {
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.xeri-window--maximized .xeri-window__resize {
    display: none;
}
